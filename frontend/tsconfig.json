{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowJs": true, "checkJs": false, "esModuleInterop": true, "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@atlas/world": ["./player/src/core/api.ts"], "atlas:scene": ["./player/src/scenes/starry.ts"] }
  },
  "include": ["studio", "player", "vite.config.ts"]
}
